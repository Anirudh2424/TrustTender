# Copy to backend/.env and fill in real values. Never commit .env.
# The server refuses to start if any required value below is missing or empty.

PORT=5000
JWT_SECRET=replace-with-long-random-string   # e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=etendering_db

# Polygon operator wallet (0x + 64 hex chars). Use a dedicated testnet-only key.
POLYGON_PRIVATE_KEY=0xreplace_with_testnet_private_key

# Kaleido FabConnect REST gateway (URL has NO credentials embedded)
KALEIDO_REST_URL=https://your-env-your-node-connect.region.kaleido.io
KALEIDO_APP_USER=your_kaleido_app_credential_user
KALEIDO_APP_PASSWORD=your_kaleido_app_credential_password

# Kaleido Fabric CA (used only by enroll.js)
KALEIDO_CA_URL=https://your-env-your-node-fabric-ca.region.kaleido.io
KALEIDO_CA_USER=your_kaleido_ca_app_credential_user
KALEIDO_CA_PASSWORD=your_kaleido_ca_app_credential_password
ENROLL_ADMIN_SECRET=your_fabric_ca_admin_enrollment_secret
